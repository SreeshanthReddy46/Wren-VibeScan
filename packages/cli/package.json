{
  "name": "wren-security",
  "version": "2.1.2",
  "description": "Security scanning for AI-generated code, from your terminal.",
  "bin": {
    "wren-security": "./dist/cli.js",
    "wren": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SreeshanthReddy46/Wren-VibeScan"
  },
  "keywords": [
    "security",
    "cli",
    "vibe-coding",
    "code-scanning",
    "ai"
  ],
  "license": "MIT",
  "author": "Wren Security",
  "homepage": "https://wren.dev",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/cli.js\"",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "node --test tests/**/*.test.ts",
    "prepublishOnly": "pnpm build && node ../../scripts/smoke-test.mjs",
    "test:smoke": "node ../../scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "boxen": "7.1.1",
    "cac": "7.0.0",
    "chalk": "5.3.0",
    "cli-table3": "0.6.5",
    "ora": "8.1.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@wren/config": "workspace:*",
    "@wren/core": "workspace:*",
    "@wren/shared-types": "workspace:*",
    "tsup": "8.4.0",
    "typescript": "5.7.3"
  }
}
